{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": ["ATOMCLI_TEST_HOME"],
  "tasks": {
    "typecheck": {},
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "atomcli#test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
