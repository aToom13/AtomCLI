{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": [
    "ATOMCLI_TEST_HOME"
  ],
  "tasks": {
    "typecheck": {},
    "test": {},
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "atomcli#test": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "ATOMCLI_TEST",
        "ATOMCLI_BASH_SANDBOX_BYPASS"
      ],
      "outputs": []
    }
  }
}
