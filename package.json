{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "atomcli",
  "description": "AI-powered development tool",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "bun run --cwd AtomBase --conditions=browser src/index.ts",
    "build": "bun turbo build",
    "typecheck": "bun turbo typecheck",
    "test": "bun turbo test",
    "version:sync": "bun run AtomBase/script/sync-version.ts",
    "version:check": "bun run AtomBase/script/sync-version.ts --check"
  },
  "workspaces": {
    "packages": [
      "AtomBase",
      "libs/*",
      "libs/sdk/js"
    ],
    "catalog": {
      "@types/bun": "1.3.4",
      "@octokit/rest": "22.0.0",
      "ulid": "3.0.1",
      "@kobalte/core": "0.13.11",
      "@types/luxon": "3.7.1",
      "@types/node": "22.13.9",
      "@tsconfig/node22": "22.0.2",
      "@tsconfig/bun": "1.0.9",
      "@cloudflare/workers-types": "4.20251008.0",
      "@solid-primitives/storage": "4.3.3",
      "@tailwindcss/vite": "4.1.11",
      "diff": "8.0.2",
      "ai": "5.0.97",
      "hono": "4.13.1",
      "hono-openapi": "1.1.2",
      "fuzzysort": "3.1.0",
      "luxon": "3.6.1",
      "marked": "17.0.1",
      "marked-shiki": "1.2.1",
      "typescript": "5.8.2",
      "@typescript/native-preview": "7.0.0-dev.20251207.1",
      "zod": "4.1.8",
      "remeda": "2.26.0",
      "shiki": "3.20.0",
      "solid-list": "0.3.0",
      "tailwindcss": "4.1.11",
      "virtua": "0.42.3",
      "vite": "7.1.4",
      "@solidjs/meta": "0.29.4",
      "@solidjs/router": "0.15.4",
      "@solidjs/start": "https://pkg.pr.new/@solidjs/start@dfb2020",
      "solid-js": "1.9.10",
      "vite-plugin-solid": "2.11.10",
      "chromadb": "3.4.3"
    }
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "prettier": "3.6.2",
    "turbo": "2.9.18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aToom13/AtomCLI"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "trustedDependencies": [
    "esbuild",
    "protobufjs",
    "tree-sitter",
    "tree-sitter-bash",
    "web-tree-sitter"
  ],
  "overrides": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:"
  }
}
